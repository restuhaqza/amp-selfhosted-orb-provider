# Copy to ~/.config/amp/orb-provider.env and chmod 600.
# Token from Settings -> Orbs -> Add Orb Provider. It is shown once.

AMP_ORB_PROVIDER_TOKEN=aop_live_replace_me

# Optional: boot orbs from the systemd base image built from image/Dockerfile.
# Affects new orbs only.
# ORB_IMAGE=amp-orb-systemd:latest
